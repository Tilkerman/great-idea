# Copy to .env.production for GitHub Pages build (nested folder without \ in path).
# Never commit real secrets to git if repo is public — use CI secrets or local-only .env.production.

# Web Push (Yandex Cloud Function)
VITE_VAPID_PUBLIC_KEY=
VITE_PUSH_API_URL=

# Product analytics (PostHog EU recommended for UK/EU users)
# https://eu.posthog.com — Project Settings → Project API key
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Voice task parse (Yandex Cloud Function + Groq). Server env: GROQ_API_KEY, GROQ_MODEL
VITE_VOICE_PARSE_URL=

# Optional: custom endpoint for install button counter (legacy CountAPI still used in code)
# VITE_INSTALL_TRACKING_URL=
