# Local-only development settings. Copy to .env.local and use a unique password.
# Never commit .env.local or production values.
POSTGRES_DB=tili
POSTGRES_USER=tili
POSTGRES_PASSWORD=change-this-before-running
CORS_ORIGINS=http://localhost:5175
SESSION_TTL_DAYS=30
API_PUBLIC_URL=http://localhost:8080
APP_PUBLIC_URL=https://tili.su/app/
MAIL_FROM=hello@tili.su
MAIL_FROM_NAME=TiLi
# auto: SMTP if SMTP_HOST/USER/PASS are set, otherwise Unisender.
MAIL_TRANSPORT=auto
# Test path: a dedicated Yandex/Mail.ru mailbox (not a personal one).
# From becomes SMTP_USER. Never commit the app password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
FEEDBACK_TO_EMAIL=vasil.ev81@mail.ru
UNISENDER_API_URL=https://goapi.unisender.ru/ru/transactional/api/v1
# Leave empty until the domain check is green. Never commit a real key.
UNISENDER_API_KEY=
DATABASE_SSL=false
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:hello@tili.su
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
