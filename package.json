{
  "name": "tili-calendar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/inject-landing-env.js && node scripts/place-landing.mjs",
    "build:pages": "VITE_APP_BUILD=${VITE_APP_BUILD:-$(git rev-parse --short HEAD 2>/dev/null || echo local)} BASE_PATH=/app/ npm run build",
    "preview": "vite preview",
    "screens:landing": "node scripts/capture-landing-screens.mjs"
  },
  "dependencies": {
    "@use-gesture/react": "^10.3.1",
    "dexie": "^4.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.50.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1"
  }
}
